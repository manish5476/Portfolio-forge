rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Schema Validation Helper for Portfolio
    function isValidPortfolio(data) {
      return data.keys().hasAll(['id', 'username', 'profile', 'projects', 'achievements', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.profile is map
        && data.projects is list
        && data.projects.size() <= 100
        && data.achievements is list
        && data.achievements.size() <= 100;
    }

    // Portfolio Documents Collection
    match /portfolios/{username} {
      // Public read access for portfolios
      allow get, list: if true;

      // Allow creation if valid ID, payload matches schema, and document username equals path parameter
      allow create: if isValidId(username)
        && isValidPortfolio(incoming())
        && incoming().username == username;

      // Allow update if valid schema and path variable matches
      allow update: if isValidId(username)
        && isValidPortfolio(incoming())
        && incoming().username == username;

      // Allow delete if signed in
      allow delete: if isSignedIn();
    }
  }
}
